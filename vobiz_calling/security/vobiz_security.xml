<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vobiz_call_company_rule" model="ir.rule">
        <field name="name">Vobiz calls: the user's companies</field>
        <field name="model_id" ref="model_vobiz_call"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="vobiz_endpoint_company_rule" model="ir.rule">
        <field name="name">Vobiz SIP endpoints: the user's companies</field>
        <field name="model_id" ref="model_vobiz_endpoint"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
