<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_vobiz_expire_sessions" model="ir.cron">
        <field name="name">Vobiz: end expired softphone sign-ins</field>
        <field name="model_id" ref="model_vobiz_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="ir_cron_vobiz_clean_rooms" model="ir.cron">
        <field name="name">Vobiz: remove old call rooms</field>
        <field name="model_id" ref="model_vobiz_room"/>
        <field name="state">code</field>
        <field name="code">model._cron_clean()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
