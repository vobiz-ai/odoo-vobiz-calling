<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vobiz_call_view_list" model="ir.ui.view">
        <field name="name">vobiz.call.list</field>
        <field name="model">vobiz.call</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-muted="outcome in ('missed', 'no_answer', 'declined', 'canceled')"
                  decoration-danger="outcome in ('busy', 'failed')">
                <field name="start_date"/>
                <field name="direction"/>
                <field name="partner_number"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="outcome"/>
                <field name="talk_time"/>
                <field name="our_number" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="vobiz_call_view_form" model="ir.ui.view">
        <field name="name">vobiz.call.form</field>
        <field name="model">vobiz.call</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="outcome"/>
                            <field name="partner_number" widget="phone"/>
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="answer_date"/>
                            <field name="end_date"/>
                            <field name="talk_time"/>
                            <field name="our_number"/>
                            <field name="call_uuid" groups="base.group_no_one"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vobiz_call_view_search" model="ir.ui.view">
        <field name="name">vobiz.call.search</field>
        <field name="model">vobiz.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_number"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="mine" string="My calls" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="inbound" string="Incoming" domain="[('direction', '=', 'inbound')]"/>
                <filter name="outbound" string="Outgoing" domain="[('direction', '=', 'outbound')]"/>
                <separator/>
                <filter name="missed" string="Missed" domain="[('direction', '=', 'inbound'), ('outcome', 'in', ('missed', 'no_answer', 'declined', 'canceled'))]"/>
                <filter name="today" string="Today" domain="[('start_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="by_agent" string="Agent" context="{'group_by': 'user_id'}"/>
                    <filter name="by_outcome" string="Outcome" context="{'group_by': 'outcome'}"/>
                    <filter name="by_day" string="Day" context="{'group_by': 'start_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vobiz_call" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">vobiz.call</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No calls yet</p>
            <p>Calls made and taken with the phone icon in the top bar appear here.</p>
        </field>
    </record>

    <menuitem id="menu_vobiz_root" name="Vobiz" web_icon="vobiz_calling,static/description/icon.png" sequence="80"/>
    <menuitem id="menu_vobiz_calls" name="Calls" parent="menu_vobiz_root" action="action_vobiz_call" sequence="10"/>
    <menuitem id="menu_vobiz_endpoints" name="SIP endpoints" parent="menu_vobiz_root" action="action_vobiz_endpoints"
              sequence="80" groups="base.group_system"/>
    <menuitem id="menu_vobiz_settings" name="Settings" parent="menu_vobiz_root" action="action_vobiz_settings"
              sequence="90" groups="base.group_system"/>
</odoo>
