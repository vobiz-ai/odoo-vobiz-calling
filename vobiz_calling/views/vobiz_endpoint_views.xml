<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vobiz_endpoint_view_list" model="ir.ui.view">
        <field name="name">vobiz.endpoint.list</field>
        <field name="model">vobiz.endpoint</field>
        <field name="arch" type="xml">
            <list string="SIP endpoints" create="0" editable="bottom" decoration-muted="not allowed">
                <header>
                    <button name="action_load" type="object" string="Load from Vobiz" class="btn-primary"
                            display="always"/>
                </header>
                <field name="username"/>
                <field name="alias"/>
                <field name="linked" widget="boolean"/>
                <field name="allowed" widget="boolean"/>
                <field name="user_id" options="{'no_create': True}"/>
                <field name="in_use_by"/>
                <field name="app_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_use_in_odoo" type="object" string="Use with Odoo" icon="fa-link"
                        invisible="allowed and linked"
                        confirm="Calls placed from this endpoint will go through Odoo, and agents can sign in with it. This moves it off any other Vobiz application it is linked to now. Continue?"/>
                <button name="action_stop_using" type="object" string="Stop using" icon="fa-ban"
                        invisible="not allowed"
                        confirm="Agents can no longer sign in with this endpoint, and anyone signed in with it now is signed out. Vobiz keeps sending its calls to Odoo's application until you link it elsewhere in the Vobiz Console. Continue?"/>
            </list>
        </field>
    </record>

    <record id="action_vobiz_endpoints" model="ir.actions.act_window">
        <field name="name">SIP endpoints</field>
        <field name="res_model">vobiz.endpoint</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No SIP endpoints yet</p>
            <p>
                Click <b>Load from Vobiz</b> to list the company account's SIP endpoints, then
                <b>Use with Odoo</b> on each one agents may sign in with. Create endpoints in the
                Vobiz Console, under Endpoints.
            </p>
        </field>
    </record>
</odoo>
